# =========================
# TELEGRAM CONFIG
# =========================
BOT_TOKEN = "your_telegram_bot_token"
CHAT_ID = "your_telegram_chat_id"


# =========================
# CARTRACK CONFIG
# =========================
CARTRACK_USERNAME="your_cartrack_username"
CARTRACK_PASSWORD="your_cartrack_password"

CARTRACK_API_URL="https://fleetapi-ph.cartrack.com/rest/vehicles/status"

SYNC_INTERVAL_SECONDS=120
CARTRACK_TIMEOUT_MS=8000
CARTRACK_RETRIES=0
GPS_TO_MATCH_TOLERANCE_MINUTES=15

CRON_SECRET="your_cron_secret"
TELEGRAM_TIMEOUT_MS=5000
GEOCODING_TIMEOUT_MS=3000

# =========================
# DB CONFIG (Supabase)
# =========================
# Direct Postgres connection string (used for psql / migrations)
DATABASE_URL=postgresql://user:password@host:6543/postgres
PORT=3500
