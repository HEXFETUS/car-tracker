# =========================
# TELEGRAM CONFIG
# =========================
BOT_TOKEN = "your_telegram_bot_token"
CHAT_ID = "your_telegram_chat_id"


# =========================
# CARTRACK CONFIG
# =========================
CARTRACK_USERNAME="your_cartrack_username"
CARTRACK_PASSWORD="your_cartrack_password"

CARTRACK_API_URL="https://fleetapi-ph.cartrack.com/rest/vehicles/status"

SYNC_INTERVAL_SECONDS=120
# Batch size: number of vehicles processed per cron invocation.
# Hobby plan: keep at 2 to stay within cron-job.org's 30s timeout.
CRON_BATCH_SIZE=2
# Soft deadline: max time for a single cron batch before returning.
# Hobby plan: keep at 25000ms (25s) to stay under cron-job.org's 30s limit.
CRON_SOFT_DEADLINE_MS=25000
CARTRACK_TIMEOUT_MS=8000
CARTRACK_RETRIES=0
GPS_TO_MATCH_TOLERANCE_MINUTES=15

CRON_SECRET="your_cron_secret"
TELEGRAM_TIMEOUT_MS=5000
GEOCODING_TIMEOUT_MS=3000

# =========================
# DB CONFIG (Supabase)
# =========================
# Direct Postgres connection string (used for psql / migrations)
DATABASE_URL=postgresql://user:password@host:6543/postgres
PORT=3500
